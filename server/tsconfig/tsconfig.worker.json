{
  "compilerOptions": {
    "target": "es2016",
    "module": "commonjs",
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "strict": false,
    "noImplicitAny": false,
    "skipLibCheck": true,
    "outDir": "../dist",
    "jsx": "react-jsx"
  },
  "include": ["../src/**/*", "../../src/**/*"]
} 